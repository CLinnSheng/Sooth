# Copy to .env and fill in. Never commit .env: BOT_PRIVATE_KEY controls real funds.
RPC_URL=https://base-sepolia-rpc.publicnode.com
FACTORY=0x0000000000000000000000000000000000000000
# Block the factory was deployed in; the log scan starts here.
DEPLOY_BLOCK=0
CHAINLINK_RESOLVER=0x0000000000000000000000000000000000000000
OPTIMISTIC_RESOLVER=0x0000000000000000000000000000000000000000
# Dedicated bot wallet holding gas and bonds only. Never the admin or judge key.
BOT_PRIVATE_KEY=
# Poll interval in seconds; resolution attempts can fail or be delayed.
POLL_SECONDS=300
# Optional: POST a JSON alert here when a proposal is disputed.
ALERT_WEBHOOK=
# OpenAI-compatible chat completions endpoint; defaults to OpenCode Go.
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
# Runs that must agree before proposing; stops early on UNRESOLVABLE or disagreement.
AGENT_RUNS=2
# Hours before re-asking the agent about a market it couldn't resolve.
AGENT_RETRY_HOURS=6
# DEBUG also logs why each market was skipped this poll.
LOG_LEVEL=INFO
