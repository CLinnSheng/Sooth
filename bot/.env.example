# Copy to .env and fill in. Never commit .env: BOT_PRIVATE_KEY controls real funds.
RPC_URL=https://base-sepolia-rpc.publicnode.com
FACTORY=0x0000000000000000000000000000000000000000
# Block the factory was deployed in; the log scan starts here.
DEPLOY_BLOCK=0
CHAINLINK_RESOLVER=0x0000000000000000000000000000000000000000
OPTIMISTIC_RESOLVER=0x0000000000000000000000000000000000000000
# Dedicated bot wallet holding gas and bonds only. Never the admin or judge key.
BOT_PRIVATE_KEY=
POLL_SECONDS=30
# Optional: POST a JSON alert here when a proposal is disputed.
ALERT_WEBHOOK=
